public/data/geo/*.xlsx
public/data/geo/censo2024_*.json

# Shapefiles (too large)
public/data/geo/*.shp
public/data/geo/*.dbf
public/data/geo/*.shx
public/data/geo/*.prj
public/data/geo/*.cpg
public/data/geo/*.sbn
public/data/geo/*.sbx
public/data/geo/*.xml
